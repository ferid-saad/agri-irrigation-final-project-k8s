# =============================================================================
# Fichier .env — Agri Irrigation (développement local)
# =============================================================================
# ⚠️  NE JAMAIS COMMITER CE FICHIER — il est dans .gitignore
#
# Copiez .env.example → .env et remplissez les valeurs réelles.
# =============================================================================

# PostgreSQL
POSTGRES_USER=agri
POSTGRES_PASSWORD=CHANGEME_postgres_password

# MongoDB
MONGO_USER=agri_mongo
MONGO_PASSWORD=CHANGEME_mongo_password
MONGO_DB_NAME=notifications_db

# JWT
JWT_SECRET=CHANGEME_jwt_secret_doit_faire_au_moins_32_caracteres
JWT_EXPIRES_IN=24h

# Frontend (optionnel, défaut : 80)
FRONTEND_PORT=80
