apiVersion: v1
kind: Secret
metadata:
  name: agri-secrets
  namespace: agri-irrigation
type: Opaque
stringData:
  postgres-user: "REMPLACER_PAR_VRAI_USER"
  postgres-password: "REMPLACER_PAR_VRAI_MOT_DE_PASSE"
  jwt-secret: "REMPLACER_PAR_JWT_SECRET_MIN_32_CHARS"
  mongo-user: "REMPLACER_PAR_MONGO_USER"
  mongo-password: "REMPLACER_PAR_MONGO_PASSWORD"
